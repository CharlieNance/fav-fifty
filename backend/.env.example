# ───────────────────────────────────────────────────────────────────────────
# Fav Fifty backend (FastAPI) — environment template.
#
# Copy to backend/.env (git-ignored) and fill in real values. Loaded by
# pydantic-settings (app/core/config.py) when you run the backend from the
# backend/ directory. Real environment variables always win over the file.
# THIS REPO IS PUBLIC — never put real secrets in this example file.
#
#   cp .env.example .env        # run from backend/
# ───────────────────────────────────────────────────────────────────────────

# development | staging | production
APP_ENV=development

# PostgreSQL connection URL (SQLAlchemy + psycopg 3 driver).
# Matches the local docker-compose Postgres credentials.
DATABASE_URL=postgresql+psycopg://favfifty:password@localhost:5432/favfifty

# Comma-separated list of allowed CORS origins (the Vue dev server, prod site).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Added when we wire auth (feat/auth-seam) ──────────────────────────────
# Signs/verifies the HttpOnly session cookie. Generate a long random value.
SECRET_KEY=change-me-to-a-long-random-string

# Session cookie tunables (optional — sensible defaults in app/core/config.py).
# The Secure flag is derived from APP_ENV (off in development, on otherwise).
# SESSION_COOKIE_NAME=favfifty_session
# SESSION_MAX_AGE_SECONDS=1209600   # 14 days

# Where the SPA lives. Used to resolve the post-login redirect to an absolute URL
# and as the default landing page. Set to https://favfifty.com in production.
FRONTEND_URL=http://localhost:5173

# ─── AWS Cognito (real Google→Cognito login) ───────────────────────────────
# Leave every COGNITO_* value blank for local dev: the dev-login stub stands in,
# and /auth/login|callback return 404. Fill them ALL in (see docs/SETUP.md §3) to
# activate the real flow. In AWS, source COGNITO_CLIENT_SECRET + SECRET_KEY from
# Secrets Manager / SSM — never commit them.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=                 # host only, e.g. favfifty.auth.us-east-1.amazoncognito.com
COGNITO_REGION=us-east-1

# Absolute URL of our own /auth/callback — MUST be registered as an allowed
# callback URL on the Cognito app client, exactly. Use your API's real origin in
# production, e.g. https://api.favfifty.com/auth/callback.
COGNITO_REDIRECT_URI=http://localhost:8000/auth/callback

# Google OAuth credentials — consumed by Cognito's Google IdP config in the AWS
# console, NOT read by this app (kept here so all auth secrets live in one place).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
