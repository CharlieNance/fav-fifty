# EditorConfig — editor-level line endings and indentation.
# https://editorconfig.org  (most editors support it natively or via a plugin.)
#
# Git already normalizes line endings on check-in via .gitattributes; this is the
# belt to that braces. .gitattributes keeps the *repo* clean no matter what an
# editor does, while this keeps the *working tree* clean in the first place, so
# CRLF never shows up in a local diff. Keep the two files in agreement — the
# eol/end_of_line rules below deliberately mirror .gitattributes.

root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Backend: 4-space indents, 100 cols (matches [tool.ruff] in backend/pyproject.toml).
[*.py]
indent_size = 4
max_line_length = 100

# Frontend: Prettier owns the formatting; these match frontend/.prettierrc.json.
[*.{ts,js,vue,css,json,jsonc}]
max_line_length = 100

# Windows-native scripts stay CRLF, as .gitattributes also specifies.
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Markdown uses trailing double-spaces as a hard line break — do not strip them.
[*.md]
trim_trailing_whitespace = false
