# ───────────────────────────────────────────────────────────────────────────
# Fav Fifty backend (FastAPI) — environment template.
#
# Copy to backend/.env (git-ignored) and fill in real values. Loaded by
# pydantic-settings (app/core/config.py) when you run the backend from the
# backend/ directory. Real environment variables always win over the file.
# THIS REPO IS PUBLIC — never put real secrets in this example file.
#
#   cp .env.example .env        # run from backend/
# ───────────────────────────────────────────────────────────────────────────

# development | staging | production
APP_ENV=development

# PostgreSQL connection URL (SQLAlchemy + psycopg 3 driver).
# Matches the local docker-compose Postgres credentials.
DATABASE_URL=postgresql+psycopg://favfifty:password@localhost:5432/favfifty

# Comma-separated list of allowed CORS origins (the Vue dev server, prod site).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Added when we wire auth (feat/auth-seam) ──────────────────────────────
# Signs/verifies the HttpOnly session cookie. Generate a long random value.
SECRET_KEY=change-me-to-a-long-random-string

# Session cookie tunables (optional — sensible defaults in app/core/config.py).
# The Secure flag is derived from APP_ENV (off in development, on otherwise).
# SESSION_COOKIE_NAME=favfifty_session
# SESSION_MAX_AGE_SECONDS=1209600   # 14 days
# ADMIN_RECENT_LOGIN_SECONDS=43200  # admin routes need a sign-in this recent (12 h)

# Admin dashboard (docs/ARCHITECTURE.md §Dashboards).
# REQUEST_COUNTS_ENABLED=true        # per-minute request counts into Postgres
# CLOUDWATCH_DASHBOARD_URL=          # link shown on the admin dashboard (set at deploy)
# COST_SNAPSHOT_ENABLED=false        # daily job's Cost Explorer call ($0.01/day); needs ce:GetCostAndUsage

# The IP block list the admin abuse view edits (app/core/ip_blocklist.py). "local" is
# a git-ignored JSON file nothing enforces; "waf" is the two WAFv2 IP sets (Terraform)
# the edge enforces. The box's IAM user needs wafv2:GetIPSet/UpdateIPSet on both.
# IP_BLOCKLIST_SOURCE=local           # local | waf
# IP_BLOCKLIST_LOCAL_PATH=.ip_blocklist.local.json
# WAF_IPV4_IP_SET_ARN=arn:aws:wafv2:us-east-1:<account>:global/ipset/<name>/<id>
# WAF_IPV6_IP_SET_ARN=

# Where the SPA lives. Used to resolve the post-login redirect to an absolute URL
# and as the default landing page. Set to https://favfifty.com in production.
FRONTEND_URL=http://localhost:5173

# Which deployment this is, and the build — reported by GET /api/v1/health. Set by
# the image build / deploy; leave unset locally.
# DEPLOY_TARGET=local               # local | lightsail | lambda
# GIT_SHA=unknown
# Any DEPLOY_TARGET other than local refuses to boot with APP_ENV=development.

# Postgres cancels app queries running longer than this (0 = off).
# DB_STATEMENT_TIMEOUT_MS=5000

# Secret CloudFront sends as X-Origin-Verify. When set, every request without it
# (except /health) is a 403, and CloudFront-Viewer-Address is trusted as the client
# IP. Required when DEPLOY_TARGET=lightsail. Leave empty locally. A real secret.
# ORIGIN_VERIFY_SECRET=

# ─── Runtime settings (limits + switches; app/core/runtime_settings.py) ───────
# Changeable without a deploy. In AWS they come from SSM Parameter Store
# (RUNTIME_SETTINGS_SOURCE=ssm, one parameter per setting under the prefix, e.g.
# /favfifty/settings/limits/max_tags_per_list). Locally, override any of them with
# a RUNTIME_<GROUP>__<NAME> variable; unset ones use their code defaults. Invalid
# values are logged and fall back to the default.
# RUNTIME_SETTINGS_SOURCE=env       # env | ssm
# RUNTIME_SETTINGS_SSM_PREFIX=/favfifty/settings
# Feature switches. Optional features default to off.
# RUNTIME_FEATURES__EVENTS_ENABLED=false   # first-party analytics (POST /events)
# RUNTIME_LIMITS__MAX_TAGS_PER_LIST=25   # 1–200
# RUNTIME_LIMITS__MAX_LISTS_PER_IMPORT=100   # 1–1000
# RUNTIME_LIMITS__MAX_IMPORT_BYTES=5242880   # 65536–52428800 (5 MiB)
# RUNTIME_LIMITS__MAX_LISTS_PER_USER=100   # 1–10000
# RUNTIME_LIMITS__MAX_WRITES_PER_USER_PER_DAY=2000   # 1–1000000
# Rate limits (app/api/rate_limits.py). ENABLED=false turns them all off.
# RUNTIME_RATE_LIMITS__ENABLED=true
# RUNTIME_RATE_LIMITS__AUTH_PER_MINUTE=20    # per IP
# RUNTIME_RATE_LIMITS__CONFIG_PER_MINUTE=60  # per IP
# RUNTIME_RATE_LIMITS__EVENTS_PER_MINUTE=20  # per IP (batches, not events)
# RUNTIME_RATE_LIMITS__WRITES_PER_MINUTE=120 # per user
# RUNTIME_RATE_LIMITS__IMPORTS_PER_HOUR=5    # per user

# ─── AWS Cognito (real Google→Cognito login) ───────────────────────────────
# Leave every COGNITO_* value blank for local dev: the dev-login stub stands in,
# and /auth/login|callback return 404. Fill them ALL in (see docs/SETUP.md §3) to
# activate the real flow. In AWS, source COGNITO_CLIENT_SECRET + SECRET_KEY from
# Secrets Manager / SSM — never commit them.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=                 # host only, e.g. favfifty.auth.us-east-1.amazoncognito.com
COGNITO_REGION=us-east-1

# Absolute URL of our own /api/v1/auth/callback — MUST be registered as an allowed
# callback URL on the Cognito app client, exactly. In production the API shares the
# site's origin: https://favfifty.com/api/v1/auth/callback.
COGNITO_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Google OAuth credentials — consumed by Cognito's Google IdP config in the AWS
# console, NOT read by this app (kept here so all auth secrets live in one place).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
