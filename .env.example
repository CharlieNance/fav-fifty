# ───────────────────────────────────────────────────────────────────────────
# Fav Fifty — environment variable template
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# THIS REPO IS PUBLIC — never put real secrets in this example file.
#
#   cp .env.example .env
# ───────────────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
APP_BASE_URL=http://localhost:5173  # frontend origin (for CORS / OAuth redirects)
API_BASE_URL=http://localhost:8000  # backend origin

# ─── Backend / FastAPI ─────────────────────────────────────────────────────
# Used to sign/verify session tokens, CSRF, etc. Generate a long random value.
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated list of allowed CORS origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://favfifty:password@localhost:5432/favfifty

# ─── Auth: Social OAuth providers ──────────────────────────────────────────
# If using AWS Cognito as the broker, most of these live in Cognito config and
# you'll mainly need the Cognito values. Listed here for reference / local dev.

# Google  — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — https://developers.facebook.com/apps
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Apple — https://developer.apple.com/account/resources/identifiers/list/serviceId
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=

# ─── AWS Cognito (if used as the auth broker) ──────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=                     # e.g. favfifty.auth.us-east-1.amazoncognito.com
COGNITO_REGION=us-east-1

# ─── AWS (deployment / SDK) ────────────────────────────────────────────────
# Prefer IAM roles in deployed environments. These are for local tooling only.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
